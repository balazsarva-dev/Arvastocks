# Ignore node_modules (dependencies should be installed inside the container)
node_modules

# Ignore build output (it will be generated inside the container)
dist
build

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment files (use Docker secrets or environment variables instead)
.env
.env.local
.env.development
.env.production
.env.test

# Ignore temporary files and directories
*.swp
*.swo
*.tmp
*.temp
.DS_Store
Thumbs.db

# Ignore Git files
.git
.gitignore

# Ignore editor and IDE files
.vscode
.idea
*.iml
